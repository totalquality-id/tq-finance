// TQ Finance — penagihan & invoicing PT. Total Quality Indonesia
// Database Schema — Prisma + PostgreSQL (lokal: Laragon / produksi: Supabase)
// Nominal uang memakai Decimal(18,2); tanggal bisnis disimpan sebagai tengah malam UTC.

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ─── SISTEM: PENGGUNA, AUDIT, PARAMETER ──────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  password       String
  role           String // MANAJER_KEUANGAN | STAF_KEUANGAN | PIMPINAN
  isActive       Boolean   @default(true)
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  notifications Notification[]
  auditLogs     AuditLog[]
}

model LoginAttempt {
  key      String   @id
  attempts Int      @default(0)
  resetAt  DateTime

  @@index([resetAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  actorName String
  action    String // CREATE | UPDATE | DELETE | VOID | SEND | FOLLOW_UP | PAYMENT | EXPORT
  module    String
  recordId  String?
  before    Json?
  after     Json?
  note      String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([module, createdAt])
  @@index([recordId])
}

model Setting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model Sequence {
  key   String @id
  value Int    @default(0)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // INVOICE_DUE | FOLLOW_UP | TERMIN_DUE
  title     String
  body      String
  link      String?
  severity  String    @default("INFO") // INFO | WARNING | DANGER
  dedupeKey String
  dueDate   DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

// ─── MASTER DATA ─────────────────────────────────────────────────────────────

// Copart (sebutan TQ untuk klien).
model Contact {
  id              String   @id @default(cuid())
  code            String   @unique
  shortCode       String? // singkatan di nomor invoice, mis. ELD → INV-ELD/1247/09/26
  type            String   @default("CLIENT")
  name            String
  npwp            String?
  isPkp           Boolean  @default(false)
  pic             String?
  email           String?
  phone           String?
  address         String?
  city            String?
  industry        String?
  paymentTermDays Int      @default(14)
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  projects Project[]
  invoices Invoice[]
}

// Kontrak Copart (dari Berita Acara Closing) beserta termin penagihannya.
model Project {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  clientId      String
  serviceType   String // SYSTEM | PROJECT | TRAINING | AUDIT | LAINNYA
  standard      String? // nama program, mis. Quality Management System (ISO 9001)
  department    String? // CCD | BSD | SDO | HRD | CSD
  presenter     String? // CCO/BSD/SDO, mis. FHR|YSF
  contractNo    String?
  spkNo         String?
  contractDate  DateTime?
  contractValue Decimal   @default(0) @db.Decimal(18, 2)
  startDate     DateTime
  endDate       DateTime?
  manager       String? // SDO pelaksana
  status        String    @default("AKTIF") // AKTIF | DITAHAN | SELESAI | BATAL
  description   String? // keterangan tambahan terkait keuangan
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client     Contact            @relation(fields: [clientId], references: [id])
  milestones ProjectMilestone[]
  invoices   Invoice[]
}

model ProjectMilestone {
  id        String    @id @default(cuid())
  projectId String
  sequence  Int
  name      String
  percent   Decimal   @default(0) @db.Decimal(7, 4)
  amount    Decimal   @default(0) @db.Decimal(18, 2)
  dueDate   DateTime?
  invoiceId String?   @unique
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoice   Invoice?  @relation(fields: [invoiceId], references: [id])

  @@index([projectId])
}

// ─── INVOICE ─────────────────────────────────────────────────────────────────

// Dua seri: TQ (kop & stempel TQ, PPN, rekening perusahaan, nomor 1xxx) dan
// OPS (polos, tanpa PPN, rekening operasional, nomor 2xxx).
model Invoice {
  id           String    @id @default(cuid())
  number       String    @unique // INV-COP/NO/MM/YY
  series       String // TQ | OPS
  seq          Int? // nomor urut dalam seri; kosong untuk nomor format lama hasil impor
  docType      String    @default("INVOICE") // INVOICE | KWITANSI
  category     String    @default("KONTRAK") // KONTRAK | AKOMODASI | LAINNYA
  layout       String    @default("JASA") // JASA | TIKET
  clientId     String
  projectId    String?
  date         DateTime
  dueDate      DateTime
  attn         String?
  reference    String? // No. PO / SPK Copart
  subject      String? // judul rincian, mis. Biaya Transportasi — Audit Maintenance
  taxInvoiceNo String? // No. faktur pajak
  items        Json // [{description, detail, route, ref, amount}]
  taxMode      String    @default("NONE") // NONE | PPN_INCLUDED | PPN_EXCLUDED
  ppnRate      Decimal   @default(11) @db.Decimal(5, 2)
  subtotal     Decimal   @db.Decimal(18, 2)
  dpp          Decimal   @db.Decimal(18, 2)
  ppn          Decimal   @default(0) @db.Decimal(18, 2)
  total        Decimal   @db.Decimal(18, 2)
  paid         Decimal   @default(0) @db.Decimal(18, 2) // diterima + PPh 23 + biaya bank
  status       String    @default("UNPAID") // UNPAID | PARTIAL | PAID | VOID
  notes        String? // catatan tercetak
  internalNote String?
  sentAt       DateTime?
  sentVia      String? // EKSPEDISI | EMAIL | WHATSAPP | LANGSUNG
  sentNote     String?
  voidReason   String?
  createdBy    String
  creatorName  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  client    Contact           @relation(fields: [clientId], references: [id])
  project   Project?          @relation(fields: [projectId], references: [id])
  payments  InvoicePayment[]
  followUps InvoiceFollowUp[]
  milestone ProjectMilestone?

  @@unique([series, seq])
  @@index([status, dueDate])
  @@index([clientId])
  @@index([date])
}

model InvoicePayment {
  id            String   @id @default(cuid())
  invoiceId     String
  date          DateTime
  account       String // TQ | OPS — rekening penerima
  amount        Decimal  @db.Decimal(18, 2) // dana diterima di rekening
  pph23         Decimal  @default(0) @db.Decimal(18, 2) // dipotong Copart
  bankFee       Decimal  @default(0) @db.Decimal(18, 2)
  buktiPotongNo String?
  notes         String?
  createdBy     String
  creatorName   String
  createdAt     DateTime @default(now())
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([date])
}

// Follow up penagihan (SOP: 2–3 hari setelah invoice dikirim).
model InvoiceFollowUp {
  id          String    @id @default(cuid())
  invoiceId   String
  date        DateTime
  channel     String // TELEPON | EMAIL | WHATSAPP | KUNJUNGAN
  note        String
  promiseDate DateTime? // janji bayar dari Copart
  createdBy   String
  creatorName String
  createdAt   DateTime  @default(now())
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, date])
}
