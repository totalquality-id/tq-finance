# Runtime. Development memakai PostgreSQL lokal (mis. Laragon, port 5432).
DATABASE_URL="postgresql://ammarqorni@localhost:5432/tq_finance?schema=public"
# Produksi (Supabase): postgresql://USER.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?schema=public&sslmode=require
# Untuk migrasi ke Supabase isi DIRECT_URL (koneksi langsung port 5432).
AUTH_SECRET="GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES"
AUTH_URL="http://localhost:3000"
# Dipakai Vercel Cron untuk /api/cron/reminders
CRON_SECRET="RANDOM_SECRET"
APP_TIMEZONE="Asia/Jakarta"
# Akun Manajer Keuangan pertama yang dibuat seeder
SEED_ADMIN_EMAIL="finance@totalquality.co.id"
SEED_ADMIN_PASSWORD="GANTI_KATA_SANDI_MIN_10"
# Token Management API Supabase (hanya untuk scripts/setup-db.mjs, tidak dipakai runtime)
